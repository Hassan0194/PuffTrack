{
  "expo": {
    "name": "PuffTrack",
    "slug": "pufftrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Pufftrack.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#081210",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Pufftrack.png",
      "resizeMode": "contain",
      "backgroundColor": "#081210"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pufftrack.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#081210"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/Pufftrack.png"
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PuffTrackWidget",
              "label": "PuffTrack",
              "description": "Track your daily puffs",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2
            }
          ]
        }
      ]
    ]
  }
}
